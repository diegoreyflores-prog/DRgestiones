<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="DR Gestiones: asesoría contable, tributaria y laboral para empresas y emprendedores en Chile.">
  <title>DR Gestiones | Asesoría Contable, Tributaria y Laboral</title>
  <link rel="icon" href="assets/logo-dr-gestiones.png">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
  <div class="market-bar">
    <div class="wrap market-inner">
      <div class="market-left">
        <strong id="fecha">Cargando fecha...</strong>
        <span><b>UF:</b> <strong id="uf">...</strong></span>
        <span><b>UTM:</b> <strong id="utm">...</strong></span>
        <span><b>USD:</b> <strong id="dolar">...</strong></span>
        <span><b>EURO:</b> <strong id="euro">...</strong></span>
      </div>
      <a class="instagram-link" href="https://www.instagram.com/drgestiones/" target="_blank" rel="noopener" aria-label="Instagram de DR Gestiones">
        <span class="instagram-icon">◎</span>
        <strong>DR Gestiones</strong>
      </a>
    </div>
  </div>

  <header class="brand-header">
    <div class="wrap brand-row">
      <div class="brand-block">
        <img src="assets/logo-dr-gestiones.png" alt="Logo DR Gestiones">
        <div class="brand-copy">
          <h1><span>DR</span> GESTIONES</h1>
          <p class="brand-services">ASESORÍA CONTABLE · TRIBUTARIA · LABORAL</p>
          <p class="slogan">Orden, confianza y crecimiento para tu empresa.</p>
        </div>
      </div>

      <div class="contact-strip">
        <div class="contact-item">
          <span class="round-icon">☎</span>
          <div><strong>+56 9 3068 9052</strong><small>Llámanos</small></div>
        </div>
        <div class="contact-item">
          <span class="round-icon">✉</span>
          <div><strong>diego.reyflores@gmail.com</strong><small>Escríbenos</small></div>
        </div>
      </div>
    </div>
  </header>

  <nav class="main-nav">
    <div class="wrap nav-inner">
      <button class="menu-btn" aria-label="Abrir menú">☰</button>
      <div class="nav-links">
        <a class="active" href="#inicio">INICIO</a>
        <a href="#nosotros">NOSOTROS</a>
        <a href="#servicios">SERVICIOS</a>
        <a href="#herramientas">HERRAMIENTAS</a>
        <a href="#blog">BLOG</a>
        <a href="#recursos">RECURSOS</a>
        <a href="#contacto">CONTACTO</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero" id="inicio">
      <div class="hero-overlay"></div>
      <div class="wrap hero-content reveal">
        <h2>Asesoría Contable,<br>Tributaria y Laboral<br><span>para tu Empresa</span></h2>
        <p>Entregamos soluciones profesionales para que puedas tomar decisiones con confianza y hacer crecer tu negocio.</p>
        <div class="hero-actions">
          <a class="btn primary" href="#servicios">▣ CONOCE NUESTROS SERVICIOS</a>
          <a class="btn outline whatsapp-btn" href="https://wa.me/56930689052" target="_blank" rel="noopener"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.85 3 3 8.75 3 15.82c0 2.49.73 4.92 2.11 7L3 29l6.38-2.03a13.2 13.2 0 0 0 6.65 1.79h.01C23.23 28.76 29 23 29 15.91 29 8.83 23.23 3 16.04 3zm0 23.58h-.01a11.04 11.04 0 0 1-5.63-1.54l-.4-.24-3.79 1.21 1.24-3.67-.26-.42a10.68 10.68 0 0 1-1.69-5.78C5.5 10.27 10.22 5.5 16.04 5.5c5.81 0 10.53 4.77 10.53 10.42 0 5.87-4.72 10.66-10.53 10.66z"/></svg> ESCRÍBENOS POR WHATSAPP</a>
        </div>
      </div>
    </section>

    <section class="services-section" id="servicios">
      <div class="wrap">
        <div class="section-title">
          <h2>NUESTRAS <span>ÁREAS</span> DE SERVICIO</h2>
        </div>
        <div class="service-grid">
          <article class="service-card reveal"><div class="service-icon">▦</div><h3>Contabilidad</h3><p>Llevamos tu contabilidad de forma ordenada y transparente.</p></article>
          <article class="service-card reveal"><div class="service-icon">SII</div><h3>Tributaria</h3><p>Planificación y cumplimiento tributario para optimizar tu carga fiscal.</p></article>
          <article class="service-card reveal"><div class="service-icon">👥</div><h3>Laboral</h3><p>Gestión de remuneraciones y cumplimiento de obligaciones laborales.</p></article>
          <article class="service-card reveal"><div class="service-icon">↗</div><h3>Financiera</h3><p>Análisis y reportes para mejorar la salud financiera de tu empresa.</p></article>
          <article class="service-card reveal"><div class="service-icon">▥</div><h3>Constitución de Empresas</h3><p>Te acompañamos en todo el proceso de creación de tu empresa.</p></article>
          <article class="service-card reveal"><div class="service-icon">🤝</div><h3>Asesoría Integral</h3><p>Un aliado estratégico para impulsar el crecimiento de tu negocio.</p></article>
        </div>
      </div>
    </section>

    <section class="about-section" id="nosotros">
      <div class="wrap">
        <div class="section-title about-title">
          <span class="eyebrow">NOSOTROS</span>
          <h2>Experiencia que se transforma en <span>gestión</span></h2>
        </div>
        <div class="about-grid">
          <article class="about-card reveal">
            <h3>Experiencia que se transforma en gestión</h3>
            <p><strong>DR Gestiones nace de la experiencia profesional y de la convicción de que una gestión contable eficiente debe ir mucho más allá del cumplimiento de las obligaciones de una empresa.</strong></p>
            <p>Nuestra trayectoria en materias contables, tributarias, laborales y administrativas nos ha permitido conocer de manera directa los desafíos que enfrentan emprendedores y empresas en las distintas etapas de su desarrollo.</p>
            <p>A partir de esa experiencia surge <strong>DR Gestiones</strong>, con el propósito de entregar un servicio profesional que combine conocimiento técnico, rigurosidad y una comprensión integral de cada negocio.</p>
            <p>Entendemos que detrás de cada cifra existe una decisión y que una contabilidad correctamente gestionada no solo permite cumplir con las obligaciones legales y tributarias, sino también disponer de información confiable para evaluar resultados, anticipar escenarios y proyectar el crecimiento de una organización.</p>
            <p>Por esta razón, nuestro trabajo se basa en conocer la realidad de cada cliente, comprender sus necesidades y transformar la información contable y financiera en herramientas útiles para su gestión.</p>
          </article>
          <article class="about-card reveal">
            <h3>Nuestra forma de trabajar</h3>
            <p>En <strong>DR Gestiones</strong> entendemos la asesoría como un proceso permanente de acompañamiento.</p>
            <p>Trabajamos bajo principios de <strong>responsabilidad, confidencialidad, rigurosidad técnica y comunicación clara</strong>, procurando que nuestros clientes tengan una visión comprensible y actualizada de la situación de sus negocios.</p>
            <p>Nuestro objetivo no es únicamente responder a una obligación cuando esta se presenta, sino contribuir a una gestión ordenada y preventiva que permita reducir contingencias, mejorar los procesos administrativos y facilitar una adecuada toma de decisiones.</p>
          </article>
          <article class="about-card reveal">
            <h3>Nuestro compromiso</h3>
            <p>Nos comprometemos a entregar soluciones acordes con la realidad y etapa de desarrollo de cada organización, manteniendo altos estándares de calidad profesional y una atención cercana.</p>
            <p>Desde el cumplimiento contable y tributario hasta la gestión laboral, administrativa y financiera, buscamos integrar las distintas áreas que forman parte del funcionamiento de una empresa.</p>
            <p>Porque entendemos que una gestión sólida comienza con información confiable, procesos ordenados y decisiones oportunas.</p>
          </article>
          <article class="about-card reveal">
            <h3>Nuestra visión</h3>
            <p>Aspiramos a consolidar <strong>DR Gestiones</strong> como una firma de servicios profesionales reconocida por la calidad de su trabajo, la confianza de sus clientes y su capacidad para acompañar el crecimiento de empresas y emprendedores.</p>
            <p>Nuestra visión es construir relaciones profesionales de largo plazo, evolucionando junto a nuestros clientes y convirtiéndonos en un <strong>aliado estratégico para la gestión, el cumplimiento y el desarrollo de sus negocios</strong>.</p>
            <blockquote><strong>DR Gestiones</strong><br><em>Gestión, conocimiento y confianza para hacer crecer tu empresa.</em></blockquote>
          </article>
        </div>
      </div>
    </section>

    <section class="info-section" id="herramientas">
      <div class="wrap info-grid">
        <article class="info-card reveal">
          <span class="eyebrow">HERRAMIENTAS</span>
          <h2>Soluciones prácticas</h2>
          <p>Próximamente podrás acceder a calculadoras tributarias, laborales y financieras directamente desde nuestra página.</p>
        </article>
      </div>
    </section>

    <section class="contact-section" id="contacto">
      <div class="wrap contact-grid">
        <div class="contact-copy reveal">
          <span class="eyebrow">CONTACTO</span>
          <h2>Hablemos de tu empresa</h2>
          <p>Cuéntanos qué necesitas y te orientaremos.</p>
          <p><strong>WhatsApp:</strong> +56 9 3068 9052</p>
          <p><strong>Correo:</strong> diego.reyflores@gmail.com</p>
          <p><strong>Instagram:</strong> @drgestiones</p>
        </div>
        <form class="contact-form reveal" id="contact-form">
          <input id="nombre" type="text" placeholder="Nombre" required>
          <input id="empresa" type="text" placeholder="Empresa">
          <input id="correo" type="email" placeholder="Correo">
          <textarea id="mensaje" placeholder="¿En qué podemos ayudarte?" required></textarea>
          <button type="submit" class="btn primary full">ENVIAR CONSULTA POR WHATSAPP</button>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <img src="assets/logo-dr-gestiones.png" alt="DR Gestiones">
      <p>© 2026 DR Gestiones · Asesoría Contable, Tributaria y Laboral</p>
    </div>
  </footer>

  <a class="whatsapp-float" href="https://wa.me/56930689052" target="_blank" rel="noopener" aria-label="Abrir WhatsApp" title="WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.85 3 3 8.75 3 15.82c0 2.49.73 4.92 2.11 7L3 29l6.38-2.03a13.2 13.2 0 0 0 6.65 1.79h.01C23.23 28.76 29 23 29 15.91 29 8.83 23.23 3 16.04 3zm0 23.58h-.01a11.04 11.04 0 0 1-5.63-1.54l-.4-.24-3.79 1.21 1.24-3.67-.26-.42a10.68 10.68 0 0 1-1.69-5.78C5.5 10.27 10.22 5.5 16.04 5.5c5.81 0 10.53 4.77 10.53 10.42 0 5.87-4.72 10.66-10.53 10.66zm5.79-7.98c-.32-.16-1.88-.91-2.17-1.01-.29-.11-.5-.16-.71.16-.21.32-.82 1.01-1 1.22-.18.21-.37.24-.68.08-.32-.16-1.34-.49-2.55-1.56-.94-.82-1.58-1.84-1.76-2.15-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.7-.97-2.33-.26-.61-.52-.53-.71-.54h-.61c-.21 0-.55.08-.84.4-.29.32-1.1 1.06-1.1 2.58 0 1.52 1.13 2.99 1.29 3.2.16.21 2.21 3.42 5.46 4.66.76.32 1.36.51 1.82.65.77.24 1.47.21 2.02.13.62-.09 1.88-.76 2.15-1.49.26-.73.26-1.35.18-1.49-.08-.13-.29-.21-.61-.37z"/></svg>
